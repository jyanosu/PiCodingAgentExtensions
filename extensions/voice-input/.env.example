# Voice Input Configuration
# Copy this file to .env and fill in your values

# Whisper server URL (must expose OpenAI-compatible /v1/audio/transcriptions endpoint)
WHISPER_URL=https://your-whisper-server.example.com

# Microphone device name (run `ffmpeg -list_devices true -f dshow -i dummy` to find available devices)
# Use the exact audio device name in quotes if it contains spaces
MIC_DEVICE=Your Microphone Device Name

# Silence duration in seconds before stopping recording (default: 2)
SILENCE_DURATION=2
