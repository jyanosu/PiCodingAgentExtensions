# Voice Input Configuration
# Copy this file to .env and fill in your values

# Whisper server URL (must expose OpenAI-compatible /v1/audio/transcriptions endpoint)
WHISPER_URL=https://your-whisper-server.example.com

# Microphone device name (optional — auto-detects first real hardware mic if omitted)
# To set explicitly: MIC_DEVICE=Microphone (Your Mic Name)
# Run `ffmpeg -list_devices true -f dshow -i dummy` to list available devices

# Silence duration in seconds before stopping recording (default: 2)
SILENCE_DURATION=2
