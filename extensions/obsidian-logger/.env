# Obsidian Logger Configuration

# Toggle logging on/off (default: true). Set to false, 0, or off to disable.
# OBSIDIAN_LOGGER_ENABLED=true

# Set your Obsidian vault path below (absolute path)
# Example on Windows: OBSIDIAN_VAULT_PATH=C:/Users/YourName/Documents/ObsidianVault
# Example on Unix:    OBSIDIAN_VAULT_PATH=/home/user/ObsidianVault

OBSIDIAN_VAULT_PATH=
